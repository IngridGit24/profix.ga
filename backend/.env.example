# Copy to .env and fill in real values locally. Never commit .env.

# Server
PORT=4000
NODE_ENV=development
API_VERSION=v1
API_PREFIX=/api
BACKEND_URL=http://localhost:4000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=profixgabon_db
DB_USER=profixgabon_user
DB_PASSWORD=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin account created by `npm run seed:admin`
ADMIN_EMAIL=admin@profix.com
ADMIN_PASSWORD=

# CORS — comma-separated list of production frontend origins.
# In development, localhost and 127.0.0.1 are allowed on known dev ports.
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Cloudinary — used to sign uploads server-side. The old frontend used an
# unsigned upload preset (anyone could upload directly, logged in or not);
# this backend signs each upload request instead. Get these from the
# Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
